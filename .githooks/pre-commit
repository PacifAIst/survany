#!/bin/sh
# Blocks any commit whose staged changes contain a secret (gitleaks, rules in .gitleaks.toml).
# Installed automatically by `pnpm install` (the root `prepare` script sets core.hooksPath=.githooks).
# The `secrets` CI job runs the same scan over the full history, so bypassing this hook does not help.
GL="${GITLEAKS_BIN:-gitleaks}"
if ! command -v "$GL" >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is required and was not found." >&2
  echo "  Install v8.30.1 or later: https://github.com/gitleaks/gitleaks#installing" >&2
  echo "  (or set GITLEAKS_BIN to the binary's path). Commit blocked." >&2
  exit 1
fi
exec "$GL" git --pre-commit --staged --redact --no-banner --config .gitleaks.toml .
