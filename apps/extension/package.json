{
  "name": "@survey-anything/extension",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "fetch-assets": "node scripts/fetch-assets.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "build:e2e": "vite build --mode e2e",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@survey-anything/providers": "workspace:*",
    "@survey-anything/recipes": "workspace:*",
    "@survey-anything/shared": "workspace:*",
    "onnxruntime-web": "^1.23.0",
    "preact": "^10.27.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@preact/preset-vite": "^2.10.2",
    "@types/chrome": "^0.1.12",
    "jpeg-js": "0.4.4",
    "vite": "^7.1.9"
  }
}
