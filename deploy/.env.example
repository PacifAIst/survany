# Copy to deploy/.env, fill the first block, then run: node scripts/gen-secrets.ts
# --- You fill these -----------------------------------------------------------
PUBLIC_HOST=alerts.example.org
LIVE_HOST=live.example.org
PUBLIC_BASE_URL=https://alerts.example.org
ACME_EMAIL=you@example.org

# Telegram: create a bot with @BotFather, paste the token and the bot username (without @).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# SMTP for parallel email alerts (T1+). Example: smtps://user:pass@smtp.example.org:465
SMTP_URL=
MAIL_FROM=alerts@example.org

# --- Live view (T2, profile "ome") ---------------------------------------------
OME_ENABLED=false
# The server's public IP. Never '*': that would advertise Docker bridge addresses.
OME_HOST_IP=
OME_PUBLIC_HOST=live.example.org
OME_SIGNALING_BASE=https://live.example.org
OME_LLHLS_BASE=https://live.example.org
OME_ALLOWED_ORIGIN=https://alerts.example.org
# Origins the viewer may connect to (CSP connect-src): OME signaling and LL-HLS.
LIVE_CONNECT_SRC=https://live.example.org wss://live.example.org

# --- Human-approved actions (T3, profile "gate") ---------------------------------
GATE_AGENT_TOKEN=
GATE_UPSTREAM_URL=http://homeassistant.local:8086/mcp

# --- Optional proxy mode: provider keys stay here, not in the browser ------------
PROXY_KEY_ANTHROPIC=
PROXY_KEY_OPENAI=
PROXY_KEY_OPENROUTER=
PROXY_KEY_DEEPSEEK=

# --- Retention (SG-22). 0 deletes media as soon as its links expire. -------------
MEDIA_RETENTION_HOURS=24

# --- Generated by scripts/gen-secrets.ts (leave empty) ---------------------------
TELEGRAM_WEBHOOK_SECRET=
OME_ADMISSION_SECRET=
OME_API_TOKEN=
SERVER_HMAC_KEY=
FORWARD_AUTH_SECRET=
