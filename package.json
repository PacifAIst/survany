{
  "name": "survey-anything",
  "private": true,
  "version": "0.1.0",
  "description": "AI monitoring for any browser tab or camera, with human approval.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "postinstall": "node scripts/fetch-model.ts",
    "fetch-model": "node scripts/fetch-model.ts",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "check:gates": "node scripts/check-security-gates.ts",
    "check:licenses": "node scripts/check-licenses.ts",
    "check:alarms": "node scripts/check-alarm-period.ts",
    "check:headers": "node scripts/check-headers.ts",
    "check": "pnpm check:gates && pnpm check:licenses && pnpm check:alarms && pnpm check:headers",
    "gen-secrets": "node scripts/gen-secrets.ts",
    "doctor": "node scripts/doctor.ts",
    "secrets:scan": "gitleaks git --redact --no-banner --config .gitleaks.toml --log-opts=--all .",
    "bench": "node bench/generate-benchmarks.ts",
    "bench:providers": "vitest run -c bench/vitest.config.ts",
    "bench:provider": "node bench/run.ts",
    "demo": "node demo/serve.ts",
    "licenses:third-party": "node scripts/gen-third-party.ts",
    "sbom": "node scripts/gen-sbom.ts",
    "release:digests": "node scripts/gen-image-digests.ts",
    "pack:extension": "node scripts/pack-extension.ts",
    "pack:firefox": "node scripts/pack-extension.ts --firefox",
    "pack:source": "node scripts/pack-extension.ts --source"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.7.0",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
